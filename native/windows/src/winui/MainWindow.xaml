<Window
    x:Class="StaapWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d"
    Title="Staap">

    <!-- Native Windows 11 look (issue #72): Segoe Variable type ramp (see App.xaml) over
         the Mica system backdrop (see code-behind), card surfaces with
         rounded corners, 12px outer / 8px inner spacing. Every brush is a
         ThemeResource, so the window follows the system theme. Same controls and handlers as before: no behavior change. -->
    <Grid x:Name="RootGrid" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar: drag region via SetTitleBar in code-behind.
             Caption buttons overlay the right side, so content stays left. -->
        <Grid x:Name="AppTitleBar" Height="32">
            <TextBlock Text="Staap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn"
                                  Width="320"
                                  MinWidth="220"
                                  MaxWidth="480"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Roster card (issue #73): New Session button, session search,
                 then live runs grouped needs-input / working / idle (macOS
                 parity) with non-live history collapsed at the end; the
                 status line below the groups stays empty until a real
                 failure needs it. One shared SelectionChanged handler
                 keeps a single selection across the four lists (the
                 selection itself lives in the core run registry). -->
            <Border Grid.Column="0"
                    Margin="12,0,0,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid Padding="12" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Single New Session button: opens the in-place
                         new-session screen on the right side on every
                         press (Ctrl+N and Ctrl+Shift+N too). No
                         repeat-last, no flyout: restart/close stay
                         keyboard-only (Ctrl+R / Ctrl+W). -->
                    <Button x:Name="NewSessionButton"
                            Grid.Row="0"
                            Content="New Session"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Start a new run (Ctrl+N)"
                            Click="NewSessionButton_Click"/>
                    <TextBox x:Name="FilterBox"
                             Grid.Row="1"
                             PlaceholderText="Search sessions"
                             TextChanged="FilterBox_TextChanged"/>
                    <!-- Group lists size to content (inner scrolling off)
                         inside one outer scroller; history stays collapsed
                         until the user expands it. All four headers always
                         show, so the group order is stable even when a
                         group is empty. Order is Needs input, Working,
                         Idle (macOS parity). -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollMode="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="NeedsHeader"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ListView x:Name="NeedsInputList"
                                      SelectionMode="Single"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      SelectionChanged="Roster_SelectionChanged"/>
                            <TextBlock x:Name="WorkingHeader"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ListView x:Name="WorkingList"
                                      SelectionMode="Single"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      SelectionChanged="Roster_SelectionChanged"/>
                            <TextBlock x:Name="IdleHeader"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ListView x:Name="IdleList"
                                      SelectionMode="Single"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      SelectionChanged="Roster_SelectionChanged"/>
                            <Expander x:Name="HistoryExpander"
                                      Header="History"
                                      IsExpanded="False"
                                      Expanding="HistoryExpander_Expanding"
                                      Collapsed="HistoryExpander_Collapsed"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                                <ListView x:Name="HistoryList"
                                          SelectionMode="Single"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                          ScrollViewer.HorizontalScrollMode="Disabled"
                                          SelectionChanged="Roster_SelectionChanged"/>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Status line: stays empty until a real failure
                         needs it (no idle banner). Failures (spawn,
                         clipboard) must stay visible (fail-visible
                         principle), so it lives at the sidebar bottom
                         now that the terminal fills the right pane. -->
                    <TextBlock x:Name="StatusText"
                               Grid.Row="3"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- Resize grip between the roster card and the terminal card:
                 a keyboard-focusable Thumb so the sidebar resizes by drag
                 AND by arrow keys (keyboard parity: Left/Right move in 8px
                 steps, Home/End jump to min/max). Drag deltas go through
                 SidebarThumb_DragDelta, key presses through
                 SidebarThumb_KeyDown; both clamp the SidebarColumn width
                 to 220..480px and persist it in LocalSettings. -->
            <primitives:Thumb x:Name="SidebarThumb"
                              Grid.Column="1"
                              Width="12"
                              Margin="0,0,0,12"
                              Background="Transparent"
                              BorderThickness="0"
                              DragDelta="SidebarThumb_DragDelta"
                              KeyDown="SidebarThumb_KeyDown"
                              AutomationProperties.Name="Resize sidebar"
                              IsTabStop="True">
                <ToolTipService.ToolTip>
                    <ToolTip Content="Drag to resize the sidebar"/>
                </ToolTipService.ToolTip>
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Grip"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Grip"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Grip"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused"/>
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Grip"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Rectangle x:Name="Grip"
                                       Width="4"
                                       RadiusX="2"
                                       RadiusY="2"
                                       HorizontalAlignment="Center"
                                       Fill="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                       Opacity="0"/>
                        </Grid>
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>

            <!-- Terminal card (issue #73): the output surface fills the
                 full height of the right pane; no status label beneath.
                 With no live PTY selected the surface hides behind an
                 empty-state overlay (macOS parity): title + detail +
                 one prominent button instead of dead-end text. -->
            <Border Grid.Column="2"
                    Margin="12,0,12,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <ScrollViewer x:Name="TermScroll"
                                  Padding="12"
                                  HorizontalScrollMode="Auto"
                                  VerticalScrollMode="Auto">
                        <TextBox x:Name="TermBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontFamily="Cascadia Mono, Consolas, monospace"
                                 FontSize="13"
                                 KeyDown="RootGrid_KeyDown"
                                 PreviewKeyDown="TermBox_PreviewKeyDown"/>
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyPanel"
                                Visibility="Collapsed"
                                Spacing="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="EmptyTitle"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   TextAlignment="Center"/>
                        <TextBlock x:Name="EmptyDetail"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <Button x:Name="EmptyButton"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Center"
                                Click="EmptyButton_Click"/>
                    </StackPanel>
                    <ScrollViewer x:Name="NewSessionScroll"
                                  Visibility="Collapsed"
                                  Padding="12"
                                  HorizontalScrollMode="Disabled"
                                  VerticalScrollMode="Auto">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Start a new run"
                                       Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <TextBlock Text="Which machine?"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                            <ComboBox x:Name="MachineBox"
                                      Grid.Column="0"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="MachineBox_SelectionChanged"
                                      KeyDown="MachineBox_KeyDown"/>
                            <Button x:Name="MachineEditButton"
                                    Grid.Column="1"
                                    Content="Edit..."
                                    IsEnabled="False"
                                    Click="MachineEdit_Click"/>
                            <Button x:Name="MachineRemoveButton"
                                    Grid.Column="2"
                                    Content="Remove"
                                    IsEnabled="False"
                                    Click="MachineRemove_Click"/>
                            </Grid>
                            <TextBlock Text="This machine, a saved host, or add one - e.g. alice@buildbox"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="MachineStatus"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="Where should it work?"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PickerFolderBox"
                                         Grid.Column="0"
                                         PlaceholderText="Blank = current folder"
                                         TextChanged="PickerFolderBox_TextChanged"/>
                                <Button x:Name="PickerBrowseButton"
                                        Grid.Column="1"
                                        Content="Browse..."
                                        Click="PickerBrowse_Click"/>
                            </Grid>
                            <ComboBox x:Name="PickerRecentBox"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="PickerRecentBox_SelectionChanged"/>
                            <StackPanel x:Name="BrowserWrap"
                                        Spacing="8"
                                        Visibility="Collapsed">
                                <TextBlock x:Name="RemotePathLabel"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <ListView x:Name="RemoteBrowserList"
                                          SelectionChanged="RemoteBrowser_SelectionChanged"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Up" Click="BrowserUp_Click"/>
                                    <Button Content="Refresh" Click="BrowserRefresh_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="BrowserStatus"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="Who should do it?"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="PickerCliBox"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="PickerCliBox_SelectionChanged"/>
                            <TextBlock Text="Permission mode"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="PickerYoloBox"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="PickerYoloBox_SelectionChanged"/>
                            <TextBlock x:Name="PickerPreview"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PickerError"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right">
                                <Button Content="Cancel" Click="PickerCancel_Click"/>
                                <Button x:Name="PickerStartButton"
                                        Content="Start"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="PickerStart_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
